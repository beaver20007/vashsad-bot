# MAX Integration — переменные окружения
# Скопируй в .env и заполни реальными значениями

# Токены MAX ботов (получать через @MasterBot в MAX)
MAX_BOT_TOKEN_VASHSAD=
MAX_BOT_TOKEN_DOCRAFT=
MAX_BOT_TOKEN_VOXSPEC=

# URL вебхука (должен быть HTTPS с валидным сертификатом)
MAX_WEBHOOK_BASE_URL=https://your-domain.com

# Существующие переменные проектов (оставить без изменений)
# TELEGRAM_BOT_TOKEN_VASHSAD=...
# SUPABASE_URL=...
# UPSTASH_REDIS_URL=...
