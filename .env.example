# ВашСад Бот — переменные окружения
# Скопируй этот файл в .env и заполни значения

# ── Обязательные ─────────────────────────────────────────────
# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=7xxxxxxxxx:AAA-xxxxxxxxxxxxxxxxxxxxx

# Токен ВТОРОГО бота (admin_bot.py) от @BotFather — отдельная сущность, свой username
ADMIN_BOT_TOKEN=7xxxxxxxxx:AAA-xxxxxxxxxxxxxxxxxxxxx

# Твой Telegram ID (узнать: написать @userinfobot)
DESIGNER_TELEGRAM_ID=123456789

# API ключ Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# PostgreSQL — Neon (neon.tech) или другой хостинг
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis URL для aiogram FSM-хранилища (RedisStorage в bot.py)
# При локальном docker-compose: redis://redis:6379/0
# При Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379/0

# ── Персонализация ───────────────────────────────────────────
DESIGNER_NAME=Имя Фамилия
DESIGNER_NAME_GEN=Имени Фамилии

# ── Опционально ─────────────────────────────────────────────
# file_id фото маскота (отправь боту фото → скопируй file_id из ответа)
WELCOME_IMAGE_URL=

# URL мини-приложения на Vercel
MINI_APP_URL=https://vashsad.vercel.app

# ── Лимиты Free-тира ────────────────────────────────────────
FREE_CHAT_LIMIT=10
FREE_PHOTO_LIMIT=3
FREE_PLANTS_LIMIT=3

# ── Деплой ──────────────────────────────────────────────────
BOT_USERNAME=washsad_ai_bot
# REDIS_URL=redis://redis:6379/0   # при локальном docker-compose
# Публичный URL сервера для Telegram Webhook (без слэша в конце)
# Пример: https://yourdomain.com
# Webhook будет зарегистрирован на {WEBHOOK_URL}/telegram/{BOT_TOKEN}
# Запуск: python setup_bot.py --webhook
WEBHOOK_URL=

# ── Дашборд аналитики (/admin) ───────────────────────────
# ADMIN_TOKEN=your-secret-token-here

# ── Погода (OpenWeatherMap) ──────────────────────────────
OPENWEATHER_API_KEY=

# ── Miniapp deep links ───────────────────────────────────
MINIAPP_URL=https://vashsad.vercel.app

# ── Telegram-канал (проверка подписки + бонусы) ──────────
# Username канала с @ (бот должен быть администратором канала)
CHANNEL_USERNAME=@vashsad_channel

# ── Sentry (опционально) ─────────────────────────────────
SENTRY_DSN=

# ── Запись на консультацию (handlers/booking.py) ────────
# Контакт для кнопки "Написать" на экране "нет слотов"/"запись скоро откроется".
# Пусто -> кнопка "Написать" не рисуется (не подставляем выдуманную ссылку).
BOOKING_CONTACT_URL=

# Telegram ID тех, кто получает "Новая запись!" и видит "Управление записью",
# через запятую. Пусто -> по умолчанию DESIGNER_TELEGRAM_ID + DESIGNER_TELEGRAM_ID_2.
BOOKING_RECIPIENT_IDS=

# Запись на консультацию открыта для клиентов. Пока false — кнопка ведёт на
# экран-заглушку "Запись скоро откроется". Включать только когда всё готово.
BOOKING_OPEN_FOR_CLIENTS=false

# Еженедельная автогенерация слотов (services/scheduler.py). Выключена по
# умолчанию — "Слоты на неделю" остаётся ручной кнопкой у сотрудника.
BOOKING_AUTOSLOTS_ENABLED=false

# Расписание автогенерации (дни недели 0=пн..6=вс, часы через запятую, длительность в минутах).
# BOOKING_AUTOSLOTS_WEEKDAYS=0,1,2,3,4
# BOOKING_AUTOSLOTS_HOURS=10,14
# BOOKING_AUTOSLOTS_DURATION_MIN=60

# Переопределение форматов консультаций (цена/длительность) без деплоя кода —
# JSON-массив {"label","key","price","duration_min"}. Пусто -> дефолт в config.py.
# BOOKING_SERVICES_JSON=
