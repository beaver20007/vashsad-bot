# ВашСад Бот — переменные окружения
# Скопируй этот файл в .env и заполни значения

# ── Обязательные ─────────────────────────────────────────────
# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=7xxxxxxxxx:AAA-xxxxxxxxxxxxxxxxxxxxx

# Твой Telegram ID (узнать: написать @userinfobot)
DESIGNER_TELEGRAM_ID=123456789

# API ключ Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# PostgreSQL — Neon (neon.tech) или другой хостинг
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis — Upstash (upstash.com) или другой
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Redis URL для aiogram FSM-хранилища (RedisStorage в bot.py)
# При локальном docker-compose: redis://redis:6379/0
# При Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379/0

# ── Персонализация ───────────────────────────────────────────
DESIGNER_NAME=Имя Фамилия
DESIGNER_NAME_GEN=Имени Фамилии

# ── Опционально ─────────────────────────────────────────────
# file_id фото маскота (отправь боту фото → скопируй file_id из ответа)
WELCOME_IMAGE_URL=

# URL мини-приложения на Vercel
MINI_APP_URL=https://vashsad.vercel.app

# ── Лимиты Free-тира ────────────────────────────────────────
FREE_CHAT_LIMIT=10
FREE_PHOTO_LIMIT=3
FREE_PLANTS_LIMIT=3

# ── Подписка ────────────────────────────────────────────────
SUBSCRIPTION_PRICE=299

# ── Платежи YooKassa (заполнить позже) ──────────────────────
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/vashsad_bot

# Включить webhook-сервер YooKassa (1 = включить после деплоя на VPS)
YOOKASSA_WEBHOOK_ENABLED=0

# ── Деплой ──────────────────────────────────────────────────
BOT_USERNAME=vashsad_bot
# REDIS_URL=redis://redis:6379/0   # при локальном docker-compose

# ── Дашборд аналитики (/admin) ───────────────────────────
# ADMIN_TOKEN=your-secret-token-here

# ── Погода (OpenWeatherMap) ──────────────────────────────
OPENWEATHER_API_KEY=

# ── Miniapp deep links ───────────────────────────────────
MINIAPP_URL=https://vashsad.vercel.app

# ── Sentry (опционально) ─────────────────────────────────
SENTRY_DSN=
